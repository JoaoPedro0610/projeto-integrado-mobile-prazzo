# =============================================================
# PRAZZO - Backend | Variaveis de ambiente
# Copie este arquivo para ".env" e ajuste os valores.
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux/macOS:          cp .env.example .env
# O arquivo .env NAO vai para o Git (esta no .gitignore).
# =============================================================

# Porta em que a API sobe localmente
PORT=3333

# Ambiente de execucao: development | production
NODE_ENV=development

# Segredo usado para assinar os tokens JWT (ETAPA 2).
# Em producao, troque por uma string longa e aleatoria.
JWT_SECRET=troque-este-segredo-em-producao

# Tempo de validade do token (formatos aceitos: 15m, 1h, 7d...)
JWT_EXPIRES_IN=1d

# ---- PostgreSQL (ETAPA 4) ------------------------------------
# O valor abaixo e exatamente o banco que o docker-compose.yml
# desta pasta cria, entao normalmente nao precisa mudar nada:
#
#   docker compose up -d --wait
#   npm run migrate
#   npm run seed
#
# Se apontar para outro servidor, troque a linha inteira.
DATABASE_URL=postgresql://prazzo:prazzo@localhost:5432/prazzo
